@page "/Account/Manage/Complaints/Delete"
@inject PennStateSoft.Data.UserComplaints DB
@using PennStateSoft
@inject NavigationManager NavigationManager
@using Microsoft.EntityFrameworkCore

<PageTitle>Close Complaint</PageTitle>

<h3>Close and delete this complaint?</h3>
<div>
    <hr />
    @if (complaint is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Username</dt>
            <dd class="col-sm-10">@complaint.Username</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@complaint.Subject</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateCreated</dt>
            <dd class="col-sm-10">@complaint.Created</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2" hidden>DateClosed</dt>
            <dd class="col-sm-10" hidden>@complaint.Closed</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@complaint.Description</dd>
        </dl>
        <EditForm method="post" Model="complaint" OnValidSubmit="DeleteComplaint" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(complaint is null)">Delete</button> |
            <a href="/account/manage/complaints" class="text-decoration-none">Back to List</a>
        </EditForm>
    }
</div>

@code {
    Complaint? complaint;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        complaint = await DB.Complaint.FirstOrDefaultAsync(m => m.Id == Id);

        if (complaint is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    public async Task DeleteComplaint()
    {
        DB.Complaint.Remove(complaint!);
        await DB.SaveChangesAsync();
        NavigationManager.NavigateTo("/account/manage/complaints");
    }
}
