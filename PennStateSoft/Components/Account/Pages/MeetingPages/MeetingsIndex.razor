@page "/Account/Meetings"

@inject IDbContextFactory<PennStateSoft.Data.MeetingContext> MeetingDbFactory
@inject PennStateSoft.Data.ApplicationDbContext AppDb
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@rendermode InteractiveServer

@attribute [Authorize]

<PageTitle>Meetings</PageTitle>

<h3>Meetings</h3>

<AuthorizeView Roles="Client">
    <div class="nav-item px-3" style="text-align:right; width:95%">
        <NavLink style="text-decoration:none" href="Account/Meetings/Create">
            New
        </NavLink>
    </div>
</AuthorizeView>
<AuthorizeView Roles="Admin">
    <div class="container mb-5">
        <div class="row">
            <InputText typeof="search" @bind-Value="filteredSearch" class="form-control" style="justify-content:center; width:50%"/>
            <InputSelect id="filter" @bind-Value="filter" class="form-select ms-1" style="width:10%;">
                @foreach (var filtr in filters)
                {
                    <option value="@filtr">@filtr</option>
                }
            </InputSelect>
            <button type="submit" class="btn-sm ms-1" style="width:8%;" @onclick="@(()=>SetGridItemsProvider(meetings))">Search</button>
        </div>
    </div>
</AuthorizeView>

<QuickGrid Class="table" ItemsProvider="@gridItemsProvider">
    <TemplateColumn Context="meeting" Title="Name" Sortable="true">
        <div class="flex items-center mt-1">
            <nobr>
                @meeting.Name
            </nobr>
        </div>
    </TemplateColumn>
    <TemplateColumn Context="meeting" Title="Date">
        <div class="flex items-center mt-1">
            <nobr>
                @meeting.Date.ToLongDateString().Substring(@meeting.Date.ToLongDateString().IndexOf(',') + 2)
            </nobr>
        </div>
    </TemplateColumn>
    <TemplateColumn Context="meeting" Title="Time">
        <div class="flex items-center mt-1">
            <nobr>
                @meeting.Time
            </nobr>
        </div>
    </TemplateColumn>
    <TemplateColumn Context="meeting" Title="Room">
        <div class="flex items-center mt-1" >
            <nobr>
                @if (Rooms is not null)
                {
                    @GetMeetingRoom(meeting.RoomId).Name
                }
            </nobr>
        </div>
    </TemplateColumn>
    <TemplateColumn Context="meeting" Title="Actions">
        <button style="background-color:#4969ee; padding:0.2rem 1rem; color:white; border-radius:0.25rem;
                        margin:0.25rem 0.5rem;"
                @onclick="@(()=> OnViewClicked(meeting.Id))">
            View
        </button>
        @if (roles is not null && roles.Count() > 0 && MeetingIds!.Contains(meeting.Id))
        {
            <button style="background-color:#4969ee; padding:0.2rem 1rem; color:white; border-radius:0.25rem;
                        margin:0.25rem 0.5rem;"
                    @onclick="@(()=> OnDeleteClicked(meeting.Id))">
                Delete
            </button>
        }      
    </TemplateColumn>
</QuickGrid>

@code{
    private GridItemsProvider<Meeting>? gridItemsProvider;
    private Room? Room { get; set; }
    private List<Room>? Rooms { get; set; }
    private List<Meeting>? meetings { get; set; }
    private List<MeetingMember>? Members { get; set; }
    private ClaimsPrincipal? claimsPrincipal { get; set; }
    private List<string>? roles { get; set; }
    private List<int>? MeetingIds { get; set; } = new List<int>();
    private string[] filters = {" ", "Day", "Date", "Room", "Member", "Time" };

    [SupplyParameterFromForm]
    private string? filter { get; set; } = "";
    [SupplyParameterFromForm]
    private string filteredSearch { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        claimsPrincipal = authState.User;

        if (claimsPrincipal is null)
        {
            try
            {
                NavigationManager.NavigateTo("/Account/NotFound");
            }
            catch (NavigationException ex)
            {
                var source = ex.Source;
            }
        }
        else
        {

            using var context = MeetingDbFactory.CreateDbContext();
            var response = context.Meeting.ToList<Meeting>();
            meetings = response;
            using var RoomContext = MeetingDbFactory.CreateDbContext();
            Rooms = RoomContext.Room.AsEnumerable<Room>().ToList();

            if (claimsPrincipal.IsInRole("Admin"))
            {
                await SetGridItemsProvider(response);
            }
            else
            {
                await GetClientView(response);
            }
        }
    }
    private async Task SetGridItemsProvider(List<Meeting> meetingList)
    {
        foreach (var meeting in meetingList)
        {
            await ReleaseRoom(meeting);
        }
        if (!filter!.Equals(""))
        {
            var MeetingContext = MeetingDbFactory.CreateDbContext();
            var meetings = MeetingContext.Meeting.ToList();
            switch (filter)
            {
                case "Day":
                    meetingList = meetings.Where(m => m.Date.ToLongDateString().Substring(0, m.Date.ToLongDateString().IndexOf(",")) == filteredSearch).ToList();
                    break;
                case "Date":
                    meetingList = meetings.Where(m => m.Date.Day.ToString() == filteredSearch).ToList();
                    break;
                case "Room":
                    var context = MeetingDbFactory.CreateDbContext();
                    var room = context.Room.FirstOrDefault(r => r.Name == filteredSearch);
                    if (room is not null)
                    {
                        meetingList = meetings.Where(m => m.RoomId == room.Id).ToList();
                    }
                    break;
                case "Member":
                    var _context = MeetingDbFactory.CreateDbContext();
                    var user = AppDb.Users.FirstOrDefault(u => u.UserName == filteredSearch);
                    if (user is not null)
                    {
                        var listOfMeetings = new List<Meeting>();
                        var members = _context.Members.Where(m => m.UserId == user.Id);
                        if (members is not null)
                        {
                            
                            foreach (var member in members)
                            {
                                listOfMeetings.Add(meetings.FirstOrDefault(m => m.Id == member.MeetingId));
                            }
                        }
                        meetingList = listOfMeetings;
                    }
                    break;
                case "Time":
                    meetingList = meetings.Where(m => m.Time.ToString() == filter || (m.Time.AddHours(m.Duration).ToString().CompareTo(filteredSearch) < 0)).ToList();
                    break;
            }
        }
        var result = GridItemsProviderResult.From<Meeting>(items: meetingList!, totalItemCount: meetingList.Count);
        gridItemsProvider = req => ValueTask.FromResult(result);
    }

    private Room GetMeetingRoom(int Id)
    {
        Room = Rooms!.FirstOrDefault(r => r.Id == Id);

        return Room!;
    }

    private async Task GetClientView(List<Meeting> meetingList)
    {
        var Roles = AppDb.Roles.ToList();
        var UserID = UserManager.GetUserId(claimsPrincipal!);
        var UserRoles = AppDb.UserRoles.Where(r => r.UserId == UserID).ToList();
        roles = new List<string>();

        //Get only the roles claimed by the current user
        foreach (var userRole in UserRoles)
        {
            var role = Roles.FirstOrDefault(r => r.Id == userRole.RoleId);
            if (role is not null)
            {
                if (role.Name!.Contains("Creator"))
                {
                    roles.Add(role.Name!);
                }
            }
        }

        using var context = MeetingDbFactory.CreateDbContext();
        Members = context.Members.Where(m => m.UserId == UserID).ToList();
        meetings = new List<Meeting>();

        if (UserID is not null && Members is not null)
        {
            foreach (var member in Members)
            {
                //Get the meetings current App user has attended/been invited to
                var newMeeting = meetingList.FirstOrDefault(m => m.Id == member.MeetingId);
                meetings!.Add(newMeeting!);
            }
            //Get the meetings current user has created
            foreach (var role in roles!)
            {
                var ID = Int32.Parse(role.Substring(7));
                MeetingIds!.Add(ID);
                var newMeeting = meetingList.FirstOrDefault(m => m.Id == ID);
                if (!meetings.Contains(newMeeting!))
                {
                    meetings!.Add(newMeeting!);
                }
            }
        }
        //Set the client view
        await SetGridItemsProvider(meetings);
    }
    private async Task ReleaseRoom(Meeting meeting)
    {
        using var MeetingContext = MeetingDbFactory.CreateDbContext();

        DateOnly CurrDate = DateOnly.FromDateTime(DateTime.Now);
        TimeOnly CurrTime = TimeOnly.FromDateTime(DateTime.Now);

        if (meeting.Date < CurrDate || (meeting.Date == CurrDate && meeting.Time.AddHours(meeting.Duration) < CurrTime))
        {
            using var context = MeetingDbFactory.CreateDbContext();
            var meetingRoom = context.Room.FirstOrDefault(r => r.MeetingId == meeting!.Id);
            if (meetingRoom is not null)
            {
                meetingRoom!.MeetingId = 0;             //Release the room
                await context.SaveChangesAsync();
            }
        } 
    }

    private void OnViewClicked(int Id)
    {
        NavigationManager.NavigateTo($"Account/Meetings/Details?id={Id}");
    }
    private void OnDeleteClicked(int Id)
    {
        NavigationManager.NavigateTo($"Account/Meetings/Delete?id={Id}");
    }
}
