@inject IDbContextFactory<PennStateSoft.Data.ApplicationDbContext> AppUsersDbFactory
@inject NavigationManager NavigationManager


<div class="mt-2 mb-3">
    <InputCheckbox @bind-Value="notification.Selected" @onclick="OnSelectClick" 
                    class="darker-border-checkbox form-check-input me-4">
    </InputCheckbox>

    <strong>
        @notification.Author
    </strong>
    @notification.Message
    <span><a href="@(notification.Link)">@notification.LinkTo</a></span>
    @{
        TimeSinceCreated = DateTime.Now - notification.Created;

        if (TimeSinceCreated.Days > 0)
        {
            if (TimeSinceCreated.Days == 1)
            {
                NotificationDuration = " " + TimeSinceCreated.Days.ToString() + " day ago ";
            }
            else
            {
                NotificationDuration = " " + TimeSinceCreated.Days.ToString() + " days ago ";
            }
        }
        else if (TimeSinceCreated.Hours > 0)
        {
            if (TimeSinceCreated.Hours == 1)
            {
                NotificationDuration = " " + TimeSinceCreated.Hours.ToString() + " hour ago ";
            }
            else
            {
                NotificationDuration = " " + TimeSinceCreated.Hours.ToString() + " hours ago ";
            }
        }
        else if (TimeSinceCreated.Minutes > 0)
        {
            if (TimeSinceCreated.Minutes == 1)
            {
                NotificationDuration = " " + TimeSinceCreated.Minutes.ToString() + " minute ago ";
            }
            else
            {
                NotificationDuration = " " + TimeSinceCreated.Minutes.ToString() + " minutes ago ";
            }
        }
        else
        {
            if (TimeSinceCreated.Seconds == 1)
            {
                NotificationDuration = " " + TimeSinceCreated.Seconds.ToString() + " second ago ";
            }
            else
            {
                NotificationDuration = " " + TimeSinceCreated.Seconds.ToString() + " seconds ago ";
            }
        }
    }
    <span class="weak">@NotificationDuration</span>

    <button type="submit" class="btn btn-sm ms-3" style="float:right;"
            disabled="@(notification is null)" @onclick="DeleteNotification">
        🗙
    </button>
</div>


@code {
    [Parameter]
    public EventCallback<SaveChangesEventArgs> OnDeleteCallback { get; set; }

    [Parameter]
    public EventCallback<SaveChangesEventArgs> OnSelected { get; set; }

    [CascadingParameter]
    public Notification notification { get; set; } = default!;

    [CascadingParameter]
    public List<Notification> notifications { get; set; } = default!;

    private TimeSpan TimeSinceCreated;

    [CascadingParameter]
    public bool SelectAllNotifications { get; set; } = default!;

    [CascadingParameter]
    public List<Notification>? SelectedNotifications { get; set; } = default!;

    private string? NotificationDuration;

    protected override async Task OnInitializedAsync()
    {
        if (notifications is null || notification is null)
        {
            NavigationManager.NavigateTo("Account/NotFound");
        }
        else
        {
            if (!SelectAllNotifications)
            {
                notification.Selected = false;
                await OnSelect();
            }
        }
    }
    public async Task UpdateNotification(Notification notification)
    {
        using var context = AppUsersDbFactory.CreateDbContext();
        context.Attach(notification!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!NotificationExists(notification!.Id))
            {
                NavigationManager.NavigateTo("Account/NotFound");
            }
            else
            {
                throw;
            }
        }
    }
    public async Task DeleteNotification()
    {
        using var context = AppUsersDbFactory.CreateDbContext();
        if (notification.Selected)
        {
            context.Notifications.Remove(notification!);
            await context.SaveChangesAsync();
        }
        await OnDeleteCallback.InvokeAsync();
    }
    public async void OnSelectClick()
    {
        notification.Selected = !notification.Selected;
        await UpdateNotification(notification);
        await OnSelect();
    }
    public async Task OnSelect()
    {
        if (notification.Selected)
        {
            if (!SelectedNotifications!.Contains(notification))
            {
                SelectedNotifications!.Add(notification);
            }
        }
        else
        {
            SelectedNotifications!.Remove(notification);
        }
        await OnSelected.InvokeAsync();
    }
    bool NotificationExists(int id)
    {
        using var context = AppUsersDbFactory.CreateDbContext();
        return context.Notifications.Any(e => e.Id == id);
    }
}
