                                                        <img src="/test3.svg" alt="Meeting Icon" class="meetingImage">
                                                        <a href="Account/Meetings/Details?id=@meeting.Id" class="meetingName">@meeting.Name</a>
                                                        <span class="meetingInfo">@meeting.Date.ToShortDateString() @meeting.Time.ToShortTimeString() <span>@GetMeetingRoom(meeting.RoomId).Name</span></span>
                                                    </article>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="grid-item item2">
                                        <NavLink style="text-decoration:none" href="Account/Meetings/Create">
                                            <button class="btn-labeled btn-newMeeting">
                                                <div class="btn-label"><i class="icon1"></i></div>
                                                    <p2>Schedule a New Meeting</p2>
                                            </button>
                                        </NavLink>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class ="grid-item1 secondItem">
                            <div class="grid-container">
                                <div class="card2">
                                    <div class="header">
                                        <div class="month">August</div>
                                        <div class="year">2024</div>
                                    </div>
                                    <div class="calendar">
                                        <div class="day header">Sun</div>
                                        <div class="day header">Mon</div>
                                        <div class="day header">Tue</div>
                                        <div class="day header">Wed</div>
                                        <div class="day header">Thu</div>
                                        <div class="day header">Fri</div>
                                        <div class="day header">Sat</div>
                                        <div class="prev_day">28</div>
                                        <div class="prev_day">29</div>
                                        <div class="prev_day">30</div>
                                        <div class="prev_day">31</div>
                                        <div class="day">1</div>
                                        <div class="day">2</div>
                                        <div class="day">3</div>
                                        <div class="day">4</div>
                                        <div class="day">5</div>
                                        <div class="day">6</div>
                                        <div class="day">7</div>
                                        <div class="day">8</div>
                                        <div class="day today">9</div>
                                        <div class="day">10</div>
                                        <div class="day">11</div>
                                        <div class="day">12</div>
                                        <div class="day">13</div>
                                        <div class="day">14</div>
                                        <div class="day">15</div>
                                        <div class="day">16</div>
                                        <div class="day">17</div>
                                        <div class="day">18</div>
                                        <div class="day">19</div>
                                        <div class="day">20</div>
                                        <div class="day">21</div>
                                        <div class="day">22</div>
                                        <div class="day">23</div>
                                        <div class="day">24</div>
                                        <div class="day">25</div>
                                        <div class="day">26</div>
                                        <div class="day">27</div>
                                        <div class="day">28</div>
                                        <div class="day">29</div>
                                        <div class="day">30</div>
                                        <div class="day">31</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="grid-item1 thirdItem">
                            <div class="grid-container2">
                                <div class="grid-item3 itemCard1">
                                    <div class="card2">
                                        <p3>
                                            Notifications:
                                        </p3>
                                        <div class="grid-container">
                                            <div class="grid-item2 itemButton1">
                                                <b><a href="Account/Meetings" target="_blank">View all › </a></b>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="grid-item3 itemCard2">
                                    <div class="card2">
                                        <p3>
                                            Complaints:
                                        </p3>
                                        <div class="grid-container">
                                            <div class="grid-item2 itemButton1">
                                                <NavLink style="text-decoration:none" href="Account/Manage/Complaints">
                                                <button class="button4">
                                                    <p1>File a Complaint</p1>
                                                </button>
                                                </NavLink>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>
</AuthorizeView>

@code {
    private List<Meeting>? upcomingMeetings;
    private List<Room>? Rooms { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUpcomingMeetings();
    }

    private async Task LoadUpcomingMeetings()
    {
        using var context = MeetingDbFactory.CreateDbContext();
        var allMeetings = await context.Meeting.ToListAsync();
        Rooms = await context.Room.ToListAsync();

        DateOnly today = DateOnly.FromDateTime(DateTime.Now);

        upcomingMeetings = allMeetings
            .Where(m => m.Date >= today)
            .OrderBy(m => m.Date)
            .ThenBy(m => m.Time)
            .ToList();
    }

    private Room GetMeetingRoom(int roomId)
    {
        return Rooms!.FirstOrDefault(r => r.Id == roomId)!;
    }
}