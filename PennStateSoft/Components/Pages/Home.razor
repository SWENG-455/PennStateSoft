@page "/"

@inject IDbContextFactory<PennStateSoft.Data.MeetingContext> MeetingDbFactory

<PageTitle>Home</PageTitle>

<div3 class="page">
    <main>
        <article class="content px-4">
            <div class="card">
                <h1 class="text-color-animation" style="font-size:2.1vw;">Meeting Scheduling System (MSS)</h1>
            </div>
        </article>
    </main>
</div3>

<AuthorizeView>
    <body>  
        <div class="container">
            <div class ="card1">
                <UserGreeting></UserGreeting>
                <div class="wrapper">
                    <div class="grid-container1">
                        <div class="grid-item1 firstItem">
                            <div class="card2">
                                <h2>
                                    Meetings:
                                    <b><a href="Account/Meetings" target="_blank">View all › </a></b>
                                </h2>
                                <div class="grid-container">
                                    <div class="grid-item item1">
                                        <div class="mainList">
                                            <h3>Upcoming Meetings</h3>
                                            @if (upcomingMeetings != null){
                                                @foreach (var meeting in upcomingMeetings){
