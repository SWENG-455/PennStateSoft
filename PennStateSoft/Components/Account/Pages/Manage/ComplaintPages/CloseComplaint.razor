@page "/Account/Manage/Complaints/Delete"

@inject IDbContextFactory<PennStateSoft.Data.UserComplaints> ComplaintsDbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = "Client")]

<PageTitle>Close Complaint</PageTitle>

<div>
    @if (complaint is null)
    {
        <hr />
        <p><em>Loading...</em></p>
    }
    else
    {
        <h3 class="link-danger">Mark as resolved?</h3>
        <hr class="link-danger"/>
        <h4 class="mt-4">@complaint.Subject</h4>
        <hr/>
        <div class="forms-control border border-light border-start-0 border-end-0 border-bottom-0
               border-top-0" cols="80">
            <div class="m-3">
                 <label for="username" class="form-label" style="color:#0070E0"> Username: </label>
                <label class=" form-label m-2 me-5 text-black-50"> @complaint.Username </label>
                <label class="ms-5 form-label text-black-50"> @complaint.Created.ToLongDateString() at @complaint.Created.ToShortTimeString() </label>
            </div>
            <div class="mt-3 mb-4">
                <textarea class="text-black text-wrap" style="border:none" cols="100"
                          rows="@uIHelper.Rows" disabled>
                    @Encoding.ASCII.GetString(complaint.Description!)
                </textarea>
            </div>
        </div>
        <EditForm method="post" Model="complaint" OnValidSubmit="DeleteComplaint" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger ms-4" disabled="@(complaint is null)">Resolve</button>
            <a class="btn btn-secondary ms-2" href="Account/Manage/Complaints">
                Cancel
            </a>
        </EditForm>
    }
</div>


@code {
    Complaint? complaint;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected UIHelper uIHelper = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = ComplaintsDbFactory.CreateDbContext();
        complaint = await context.Complaint.FirstOrDefaultAsync(m => m.Id == Id);

        if (complaint is null)
        {
            NavigationManager.NavigateTo("notfound");
        }

        uIHelper.CalculateSize(@Encoding.ASCII.GetString(complaint!.Description!));
    }

    public async Task DeleteComplaint()
    {
        using var context = ComplaintsDbFactory.CreateDbContext();
        context.Complaint.Remove(complaint!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/account/manage/complaints");
    }
}
