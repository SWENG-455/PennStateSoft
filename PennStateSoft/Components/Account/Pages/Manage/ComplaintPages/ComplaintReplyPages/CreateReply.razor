@inject PennStateSoft.Data.ComplaintReplies RepliesDb
@inject NavigationManager NavigationManager
@inject IdentityUserAccessor UserAccessor;
@inject IHttpContextAccessor HttpContextAccessor
@inject UserManager<ApplicationUser> UserManager


<button type="submit" class="ms-3 btn btn-primary" @onclick="OnReplyClicked">Reply</button>
<div class="mt-3">
    <div class="m-3" style="text-align:right; width:90%">
        @if (ReplyClicked)
        {
            <EditForm method="post" Model="ComplaintReply" FormName="create" Enhance>
                <AntiforgeryToken />
                <DataAnnotationsValidator />
                <InputTextArea id="replydescription" @bind-Value="ReplyDescription" class="form-control text-wrap"
                               rows="@uIHelper.Rows" @onchange="@(()=> uIHelper.CalculateSize(ReplyDescription))" autofocus>
                </InputTextArea>
                <ValidationMessage For="() => ReplyDescription" class="text-danger" />
            </EditForm>
            <div class="m-2" style="text-align:right; width:99%">
                <button type="reset" class="btn btn-secondary" @onclick="OnCancelClicked">Cancel</button>
                <button type="submit" class="btn btn-primary" @onclick="OnSubmitClicked">Reply</button>
            </div>
        }
    </div>
    
</div>

@code {

    [SupplyParameterFromForm]
    private string ReplyDescription { get; set; } = "";

    protected UIHelper uIHelper = new();

    private Complaint? complaint;

    [SupplyParameterFromForm]
    public ComplaintReply ComplaintReply { get; set; } = new();

    private bool ReplyClicked { get; set; } = false;

    private  ApplicationUser user = default!;
    private DateTime expiry;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        complaint = ComplaintDetails.getComplaint();

        if (ReplyDescription is not null)
        {
            ComplaintReply.Description = Encoding.ASCII.GetBytes(ReplyDescription);
        }

    }
    private Task OnReplyClicked()
    {
        ReplyClicked = true;

        return Task.CompletedTask;
    }
    private Task OnCancelClicked()
    {
        ReplyClicked = false;
        ReplyDescription = "";

        return Task.CompletedTask;
    }
    private async Task OnSubmitClicked()
    {
        await OnValidSubmitAsync();
        await OnCancelClicked();
    }
    private async Task OnValidSubmitAsync()
    {
        if (HttpContext is null)
        {
            HttpContext = HttpContextAccessor.HttpContext!;
        }

        user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        if (user == null)
        {
            throw new NullReferenceException();
        }

        ComplaintReply.Username = user.UserName;
        ComplaintReply.Created = DateTime.UtcNow;
        expiry = DateTime.UtcNow.AddDays(7);
        ComplaintReply.Closed = expiry;
        ComplaintReply.Subject = complaint?.Subject;
        ComplaintReply.ComplaintId = complaint!.Id;

        if (ReplyDescription is not null)
        {
            ComplaintReply.Description = Encoding.ASCII.GetBytes(ReplyDescription);
        }
        else
        {
            await OnCancelClicked();
            return;
        }

        await AddComplaintReply();
        NavigationManager.Refresh(true);
    }

    public async Task AddComplaintReply()
    {
        RepliesDb.ComplaintReply.Add(ComplaintReply);
        await RepliesDb.SaveChangesAsync();
    }
}
