@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

<ul class="nav nav-pills flex-lg-row flex-nowrap">
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Admin" Match="NavLinkMatch.All">Profile</NavLink>
    </li>
    <li class="nav-item px-3">
        <NavLink class="nav-link" href="Account/Admin/Rooms">
            <span class="bi meetingRoomIcon" aria-hidden="true"></span>Rooms
        </NavLink>
    </li>
    <li class="nav-item">
        <NavLink id="RegAdmin" class="nav-link text-nowrap" href="Account/Admin/RegisterAdmin">
            Create Admin Account
        </NavLink>
    </li>
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
