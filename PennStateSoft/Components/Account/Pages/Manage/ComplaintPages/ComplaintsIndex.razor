@page "/Account/Manage/Complaints"

@inject IDbContextFactory<PennStateSoft.Data.UserComplaints> ComplaintsDbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider


<PageTitle>Complaints</PageTitle>

<h3>Complaints</h3>

<AuthorizeView Roles="Client">
    <div class="nav-item px-3" style="text-align:right; width:95%">
        <NavLink style="text-decoration:none" href="Account/Manage/Complaints/Create">
             New
        </NavLink>
    </div>
</AuthorizeView>

<div class="grid" tabindex="-1">
    <QuickGrid ItemsProvider="@complaintProvider" Class="table">
        <TemplateColumn Context="complaint">
            <div class="mt-3">
                <a class="text-nowrap" href="@($"account/manage/complaints/details?id={complaint.Id}")">@(complaint.Subject)</a>
            </div>
            <div class="mt-2 mb-3">
                @Encoding.ASCII.GetString(complaint.Description!)
            </div>
        </TemplateColumn>
        
        <PropertyColumn Property="@(complaint => complaint.Closed)" Class="visually-hidden" />
        
        <TemplateColumn Context="complaint">
            <div class="mt-3" style="text-align:right; width:90%">
                <div style="color:#0070E0">
                    Posted on
                </div>
                <div class="mt-2 text-nowrap text-black-50">
                    @complaint.Created.ToLongDateString().Substring(@complaint.Created.ToLongDateString().IndexOf(',') + 2) @complaint.Created.ToShortTimeString()
                </div>
            </div> 
        </TemplateColumn> 
    </QuickGrid>
</div>

@code {
    PaginationState paginationState = new PaginationState { ItemsPerPage = 10 };
    GridItemsProvider<Complaint>? complaintProvider;

    private ApplicationUser user = default!;

    private ClaimsPrincipal? claimsPrincipal { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        claimsPrincipal = authState.User;
        user = await UserManager.GetUserAsync(claimsPrincipal);

        using var context = ComplaintsDbFactory.CreateDbContext();
        var response = context.Complaint.Where(complaint => complaint.Username == user.UserName);

        if (await UserManager.IsInRoleAsync(user, "Admin")){
            response = context.Complaint;
        }
       
        var rows = response.AsEnumerable<Complaint>().ToList<Complaint>();
        var result = GridItemsProviderResult.From<Complaint>(items: rows, totalItemCount:rows.Count);
        complaintProvider = req => ValueTask.FromResult(result);
    }
}