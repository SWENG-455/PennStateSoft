@page "/"

@inject IDbContextFactory<PennStateSoft.Data.MeetingContext> MeetingDbFactory
@inject IDbContextFactory<PennStateSoft.Data.ApplicationDbContext> AppDbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

<div3 class="page">
    <main>
        <article class="content px-4">
            <div class="card">
                <h1 class="text-color-animation" style="font-size:1.9vw;">Meeting Scheduling System (MSS)</h1>
            </div>
        </article>
    </main>
</div3>

<AuthorizeView>
    <NotAuthorized>
        <div class="grid-container2 ms-5 mt-5" style="padding-top:50px;">
            <div class="grid-item3 itemCard1">
                <div class="card4">
                    <h4 class="ms-3 mb-4 mt-3" style="font-size:1.0vw; color:midnightblue;">Log in to PennStateSoft</h4>
                    <h6 class="ms-3 text-nowrap" style="color:dimgray;">PennStateSoft is a world leader in meeting scheduling</h6>
                    <h6 class="ms-3 mb-4" style="color:dimgray;"> and management software.</h6>
                    <NavLink style="text-decoration:none" href="/Account/Login">
                        <button class="btn-labeled ms-3 mt-2" style="text-align:center;">
                            <h6 class="mt-2" style="font-size:0.75vw;">LOG IN</h6>
                        </button>
                    </NavLink>
                </div>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <body>
            <div class="container">
                <div class="card1">
                    <UserGreeting></UserGreeting>
                    <div class="wrapper">
                        <div class="grid-container1">
                            <div class="grid-item1 firstItem">
                                <div class="card2">
                                    <h2>
                                        Meetings:
                                        <b><a href="Account/Meetings" target="_blank">View all › </a></b>
                                    </h2>
                                    <div class="grid-container">
                                        <div class="grid-item item1">
                                            <div class="mainList">
                                                <h3 class="header-with-line">Upcoming Meetings</h3>
                                                @if (upcomingMeetings != null)
                                                {
                                                    @foreach (var meeting in upcomingMeetings)
                                                    {
                                                        <article class="meeting">
                                                            <img src="/test3.svg" alt="Meeting Icon" class="meetingImage">
                                                            <a href="Account/Meetings/Details?id=@meeting.Id" class="meetingName">@meeting.Name</a>
                                                            <span class="meetingInfo">@meeting.Date.ToShortDateString() @meeting.Time.ToShortTimeString() 
                                                                <span>@GetMeetingRoom(meeting.RoomId).Name</span></span>
                                                        </article>
                                                    }
                                                }
                                            </div>
                                        </div>
                                        @if (!IsAdmin)
                                        {
                                            <div class="grid-item item2">
                                                <NavLink style="text-decoration:none" href="Account/Meetings/Create">
                                                    <button class="btn-labeled btn-newMeeting">
                                                        <div class="btn-label"><i class="icon1"></i></div>
                                                        <p2>Schedule a New Meeting</p2>
                                                    </button>
                                                </NavLink>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="grid-item1 secondItem">
                                <div class="grid-container">
                                    <div class="card2">
                                        <Calendar>
                                            <DayTemplate Context="day">
                                                @{
                                                    string currentDay = day.Date == DateTime.Now.Date ? "today" : "";
                                                    string selectedDay = SelectedDay == day.Day ? "selected" : "";
                                                }
                                                @if (day.IsInThisMonth)
                                                {
                                                    <div class="ms-2 day shadow-effect @selectedDay @currentDay" @onclick="@(()=>OnDayClicked(day.Day))">@day.Day</div>
                                                }
                                            </DayTemplate>
                                        </Calendar>
                                    </div>
                                </div>
                            </div>
                            <div class="grid-item1 thirdItem">
                                <div class="grid-container2">
                                    @if (!IsAdmin)
                                    {
                                        <div class="grid-item3 itemCard1">
                                            <div class="card2">
                                                <div class="row">
                                                    <strong>
                                                        <p3>
                                                            Notifications:
                                                            <a href="/Account/Notifications">View all › </a>
                                                        </p3>
                                                    </strong>
                                                </div>
                                                <div class="grid-container4">
                                                    @if (User is not null)
                                                    {
                                                        <div class="user-info" style="font-size:small;">
                                                            <CascadingValue Value="@User" IsFixed=true>
                                                                <NotificationsIndexPreview />
                                                            </CascadingValue>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @if (IsAdmin)
                                    {
                                        <div class="grid-item3 itemCardAdmin">
                                            <div class="card2">
                                                <div class="row">
                                                    <strong>
                                                        <p3>
                                                            Notifications:
                                                            <a href="/Account/Notifications">View all › </a>
                                                        </p3>
                                                    </strong>
                                                </div>
                                                <div class="grid-container">
                                                    @if (User is not null)
                                                    {
                                                        <div1 style="font-size:small;">
                                                            <CascadingValue Value="@User" IsFixed=true>
                                                                <NotificationsIndexPreview />
                                                            </CascadingValue>
                                                        </div1>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @if (!IsAdmin)
                                    {
                                        <div class="grid-item3 itemCard2">
                                            <div class="card3">
                                                <div class="row1 header1">
                                                    <strong>Complaints:</strong>
                                                </div>
                                                <div class="grid-container">
                                                    <div2 class="grid-item2 itemButton2">
                                                        <NavLink style="text-decoration:none" href="Account/Complaints/Create">
                                                            <button class="btn-labeled2 btn-newComplaint">
                                                                <div class="btn-label2"><i class="iconComplaint"></i></div>
                                                                <p4>File a Complaint</p4>
                                                            </button>
                                                        </NavLink>
                                                    </div2>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </body>
    </Authorized>
</AuthorizeView>

@code 
{
    private List<Meeting>? upcomingMeetings;
    private List<Room>? Rooms { get; set; }
    private List<IdentityRole>? Roles { get; set; }
    private ClaimsPrincipal? claimsPrincipal;
    private bool IsAdmin = false;
    private int SelectedDay = 0;
    private ApplicationUser? User;

    [Parameter]
    public string? Month { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        claimsPrincipal = authState.User;

        if (claimsPrincipal.Identity.IsAuthenticated)
        {
            await LoadUpcomingMeetings();
        }
    }

    private async Task LoadUpcomingMeetings()
    {
        using var context = MeetingDbFactory.CreateDbContext();
        var allMeetings = await context.Meeting.ToListAsync();
        Rooms = await context.Room.ToListAsync();

        User = await UserManager.GetUserAsync(claimsPrincipal);
        using var AppContext = await AppDbFactory.CreateDbContextAsync();
        var userRoles = AppContext.UserRoles.Where(ur => ur.UserId == User!.Id).ToList();
        Roles = new List<IdentityRole>();
        upcomingMeetings = new List<Meeting>();
        var someMeetings = new List<Meeting>();
        var members = context.Members.Where(m => m.UserId == User.Id);
        if (members is not null)
        {
            foreach (var member in members)
            {
                someMeetings = context.Meeting.Where(m => m.Id == member.MeetingId).ToList();
            }
        }
        

        if (userRoles is not null && userRoles.Count() > 0)
        {
            foreach (var userRole in userRoles)
            {
                var role = await AppContext.Roles.FirstOrDefaultAsync(r => r.Id == userRole.RoleId);
                if (!role.Name.Contains("Client"))
                {
                    Roles.Add(role);
                }
            }
            foreach (var role in Roles)
            {
                if (role.Name.Equals("Admin"))
                {
                    IsAdmin = true;
                    break;
                }
                else
                {
                    //Get meetings where user is either a creator or an invitee
                    int meetingId = -1, index;
                    if (role.Name.Contains("Creator"))
                    {
                        index = role.Name.LastIndexOf("r");
                        meetingId = Convert.ToInt32(role.Name.Substring(index + 1));
                    }
                    else if (role.Name.Contains("Invitee"))
                    {
                        index = role.Name.LastIndexOf("e");
                        meetingId = Convert.ToInt32(role.Name.Substring(index + 1));
                    }

                    var meeting = allMeetings.FirstOrDefault(m => m.Id == meetingId);

                    if (meeting is not null)
                    {
                        if (!upcomingMeetings.Contains(meeting))
                        {
                            upcomingMeetings.Add(meeting);
                        }
                    }
                }
            }
        }
        

        DateOnly today = DateOnly.FromDateTime(DateTime.Now);
        if (IsAdmin)
        {
            upcomingMeetings = allMeetings
            .Where(m => m.Date >= today)
            .OrderBy(m => m.Date)
            .ThenBy(m => m.Time)
            .ToList();
        }
        else
        {
            upcomingMeetings = upcomingMeetings
            .Where(m => m.Date >= today)
            .OrderBy(m => m.Date)
            .ThenBy(m => m.Time)
            .ToList();
        }
    }
    private void OnDayClicked(int index)
    {
        SelectedDay = index;
    }
    private Room GetMeetingRoom(int roomId)
    {
        return Rooms!.FirstOrDefault(r => r.Id == roomId)!;
    }
}