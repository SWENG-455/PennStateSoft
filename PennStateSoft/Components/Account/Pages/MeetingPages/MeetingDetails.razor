@page "/Account/Meetings/Details"

@inject IDbContextFactory<PennStateSoft.Data.MeetingContext> MeetingDbFactory
@inject PennStateSoft.Data.ApplicationDbContext AppDb
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@attribute [Authorize]

<PageTitle>Meeting Details</PageTitle>

<div>
    <h4>Meeting Details</h4>
    <hr />
    @if (meeting is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@meeting.Name</dd>
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-10">@meeting.Date.ToLongDateString()</dd>
            <dt class="col-sm-2">Time</dt>
            <dd class="col-sm-10">@meeting.Time</dd>
            <dt class="col-sm-2">Duration</dt>
            <dd class="col-sm-10">@meeting.Duration hr </dd>
            <dt class="col-sm-2">Room</dt>
            <dd class="col-sm-10">@room!.Name</dd>
        </dl>
        <CascadingValue Value="Id">
            <CascadingValue Value="meeting">
                <CascadingValue Value="roles">
                    <UpdateMeetingComponent />
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
       
        <div>
            @if ((roles is not null && roles.Count() > 0) && !hasEnded)
            {
                <a class="text-decoration-none me-2" href="@($"Account/Meetings/Edit?id={meeting.Id}")">
                    Edit
                </a> <span class="me-2">  | </span>
            }

            <a class="text-decoration-none" href="@($"Account/Meetings")">Back</a>
        </div>
    }
</div>

@code {
    Meeting? meeting;

    [SupplyParameterFromForm]
    private string? selectedUser { get; set; }
    private string? role { get; set; }

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    private Room? room { get; set; }
    private List<string>? roles { get; set; }
    private ClaimsPrincipal? claimsPrincipal { get; set; }
    private bool hasEnded = false;

    protected override async Task OnInitializedAsync()
    {
        using var context = MeetingDbFactory.CreateDbContext();
        meeting = await context.Meeting.FirstOrDefaultAsync(m => m.Id == Id);
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        claimsPrincipal = authState.User;

        if (meeting is not null)
        {
            var Roles = AppDb.Roles.ToList();
            var UserRoles = AppDb.UserRoles.Where(r => r.UserId == UserManager.GetUserId(claimsPrincipal)).ToList();
            roles = new List<string>();

            //Get only the roles claimed by the current user
            foreach (var userRole in UserRoles)
            {
                var role = Roles.FirstOrDefault(r => r.Id == userRole.RoleId);
                if (role is not null)
                {
                    if (role.Name!.Contains("Creator" + meeting.Id))
                    {
                        roles.Add(role.Name!);
                    }
                }
            }

            using var roomContext = MeetingDbFactory.CreateDbContext();
            room = await roomContext.Room.FirstOrDefaultAsync(r => r.Id == meeting.RoomId);
            //Check if the meeting is over
            HasEnded();
        }
        else
        {
            try
            {
                NavigationManager.NavigateTo("/Account/NotFound");
            }
            catch (NavigationException navEx)
            {
                var source = navEx.Source;
            }
        }
    }
    private void HasEnded()
    {
        DateOnly CurrDate = DateOnly.FromDateTime(DateTime.Now);
        TimeOnly CurrTime = TimeOnly.FromDateTime(DateTime.Now);

        if (meeting!.Date < CurrDate || meeting.Time.AddHours(meeting.Duration) < CurrTime)
        {
            hasEnded = true;
        }
    }
}
