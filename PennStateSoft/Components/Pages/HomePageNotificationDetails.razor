@inject IDbContextFactory<PennStateSoft.Data.ApplicationDbContext> AppDbFactory
@inject NavigationManager NavigationManager

@if (notification is null)
{
    <p>loading...</p>
}
else
{
    <div class="mt-2 mb-3">
        <strong>
            @notification.Author
        </strong>
        @notification.Message
        <span @onclick="@(()=>NotificationClicked(notification))">
            <a class="text-wrap" href="@(notification.Link)">@notification.LinkTo</a></span>
            @{
                TimeSinceCreated = DateTime.Now - notification.Created;

                if (TimeSinceCreated.Days > 0)
                {
                    if (TimeSinceCreated.Days == 1)
                    {
                        NotificationDuration = " " + TimeSinceCreated.Days.ToString() + " day ago ";
                    }
                    else
                    {
                        NotificationDuration = " " + TimeSinceCreated.Days.ToString() + " days ago ";
                    } 
                }
                else if (TimeSinceCreated.Hours > 0)
                {
                    if (TimeSinceCreated.Hours == 1)
                    {
                    NotificationDuration = " " + TimeSinceCreated.Hours.ToString() + " hour ago ";
                    }
                    else
                    {
                    NotificationDuration = " " + TimeSinceCreated.Hours.ToString() + " hours ago ";
                    }
                }
                else if (TimeSinceCreated.Minutes > 0)
                {
                    if (TimeSinceCreated.Minutes == 1)
                    {
                    NotificationDuration = " " + TimeSinceCreated.Minutes.ToString() + " minute ago ";
                    }
                    else
                    {
                    NotificationDuration = " " + TimeSinceCreated.Minutes.ToString() + " minutes ago ";
                    }
                }
                else
                {
                    if (TimeSinceCreated.Seconds == 1)
                    {
                    NotificationDuration = " " + TimeSinceCreated.Seconds.ToString() + " second ago ";
                    }
                    else
                    {
                    NotificationDuration = " " + TimeSinceCreated.Seconds.ToString() + " seconds ago ";
                    }
                }
            }
        <span class="weak text-wrap">@NotificationDuration</span>
        
    </div>
}

@code {
    [Parameter]
    public EventCallback<SaveChangesEventArgs> OnDeleteCallback { get; set; }

    [CascadingParameter]
    public Notification notification { get; set; } = default!;

    [CascadingParameter]
    public List<Notification> notifications { get; set; } = default!;

    [CascadingParameter]
    private ApplicationUser user { get; set; } = default!;

    private TimeSpan TimeSinceCreated;

    private string? NotificationDuration;

    private bool IsAdmin = false;

    protected override void OnInitialized()
    {
        if (notifications is null || notification is null)
        {
            NavigationManager.NavigateTo("/Account/NotFound");
        }
    }
    public async Task UpdateNotification(Notification notification)
    {
        using var context = AppDbFactory.CreateDbContext();
        context.Attach(notification!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!NotificationExists(notification!.Id))
            {
                NavigationManager.NavigateTo("Account/NotFound");
            }
            else
            {
                throw;
            }
        }
    }
    bool NotificationExists(int id)
    {
        using var context = AppDbFactory.CreateDbContext();
        return context.Notifications.Any(e => e.Id == id);
    }
    private async void NotificationClicked(Notification notification)
    {
        //Mark the notification clicked as read
        notification.Read = true;
        await UpdateNotification(notification);

        //Find all notifications older than the notification that was clicked
        using var context = AppDbFactory.CreateDbContext();
        var notifications = context.Notifications.ToList();
        notifications = notifications.Where(n => n.Author != user.UserName && (n.Recipient == user.UserName)).ToList();
        notifications = notifications.Where(n => n.Read == false).ToList();
        notifications = notifications.OrderByDescending(n => n.Created).ToList();
        notifications = notifications.Where(n => n.Created < notification.Created).ToList();

        //Mark them all as read as well
        if (notifications is not null)
        {
            foreach (var _notification in notifications)
            {
                _notification.Read = true;
                await UpdateNotification(_notification);
            }
        }
    }
}
