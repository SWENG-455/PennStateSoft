@page "/Account/Manage/Complaints/Details"

@using PennStateSoft
@using Microsoft.EntityFrameworkCore
@using System.Text
@using System.Text.Encodings.Web
@using PennStateSoft.Components.Account.Shared

@inject PennStateSoft.Data.UserComplaints DB
@inject NavigationManager NavigationManager


<PageTitle>Complaint Details</PageTitle>


<div>
    @if (complaint is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <h3>@complaint!.Subject</h3>
        <hr />
        <div class="forms-control border border-dark border-start-0 border-end-0 border-bottom-0 
               border-top-0" cols="80">
            <div>
                <label for="username" class=" form-label m-1"> Username: </label>
                <label class=" form-label m-2 text-black-50"> @complaint.Username </label>
            </div>
            <div>
                <label for="created" class="form-label m-2"> Created: </label>
                <label class=" form-label m-4 text-black-50"> @complaint.Created </label>
            </div>
            <div hidden>
                <label for="closed" hidden> Closed: </label>
                <label hidden> @complaint.Created </label>
            </div>
            <div>
                <textarea class="text-black m-3 text-wrap border-start-0 border-end-0" cols="100"
                          rows="@UIhelper.Rows" oninput="UIhelper.CalculateSize(Description)"
                          disabled>
                    @Encoding.ASCII.GetString(complaint.Description!)
                </textarea>
            </div>
        </div>

        <div>
            <a href="@($"/account/manage/complaints/edit?id={complaint.Id}")" class=" m-2 text-decoration-none">Edit</a> |
            <a href="@($"/account/manage/complaints")" class="text-decoration-none">Back</a> |
            <a class=" m-2 alert-danger text-decoration-none" href="@($"account/manage/complaints/delete?id={complaint.Id}")">Close</a>
            
        </div>
    }
</div>

@code {
    Complaint? complaint;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    public string? Description { get; set; }

    private UIHelper UIhelper = new();


    protected override async Task OnInitializedAsync()
    {
        
        complaint = await DB.Complaint.FirstOrDefaultAsync(m => m.Id == Id);


        if (complaint is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            if (complaint.Description is not null)
            {
                Description = Encoding.ASCII.GetString(complaint.Description);
                UIhelper.CalculateSize(Description);
            }
        }
    }
}
