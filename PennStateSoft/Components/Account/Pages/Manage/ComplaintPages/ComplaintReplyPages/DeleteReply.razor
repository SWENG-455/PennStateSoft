@page "/complaintreplies/deletereply"

@using Microsoft.EntityFrameworkCore
@using PennStateSoft
@inject IDbContextFactory<PennStateSoft.Data.ComplaintReplies> DbFactory
@inject NavigationManager NavigationManager


<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>ComplaintReply</h4>
    <hr />
    @if (complaintreply is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Username</dt>
            <dd class="col-sm-10">@complaintreply.Username</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Subject</dt>
            <dd class="col-sm-10">@complaintreply.Subject</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Created</dt>
            <dd class="col-sm-10">@complaintreply.Created</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Closed</dt>
            <dd class="col-sm-10">@complaintreply.Closed</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@complaintreply.Description</dd>
        </dl>
        <EditForm method="post" Model="complaintreply" OnValidSubmit="DeleteComplaintReply" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(complaintreply is null)">Delete</button> |
            <a href="/complaintreplies">Back to List</a>
        </EditForm>
    }
</div>

@code {
    ComplaintReply? complaintreply;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        complaintreply = await context.ComplaintReply.FirstOrDefaultAsync(m => m.Id == Id);

        if (complaintreply is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    public async Task DeleteComplaintReply()
    {
        using var context = DbFactory.CreateDbContext();
        context.ComplaintReply.Remove(complaintreply!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/complaintreplies");
    }
}
