@page "/Account/Admin/Rooms/Create"
@inject IDbContextFactory<PennStateSoft.Data.MeetingContext> MeetingDbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@attribute [Authorize(Roles = "Admin")]
<PageTitle>Create</PageTitle>

<h3> Create Room</h3>
<hr />
<p class="text-danger">
    @statusMessage
</p>

<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Room" OnValidSubmit="AddRoom" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            <div class="mb-3">
                <label for="name" class="form-label">Name:</label>
                <InputText id="name" @bind-Value="Room.Name" class="form-control" autofocus />
                <ValidationMessage For="() => Room.Name" class="text-danger" />

                @if (Rooms is not null && (Room.Name is not null && !Room.Name.Equals("")))
                {
                    foreach (var room in Rooms)
                    {
                        if (room.Name!.Equals(Room.Name))
                        {
                            statusMessage = $"Error: {Room.Name} already exists";
                            break;
                        }
                        else
                        {
                            statusMessage = "";
                        }
                    }
                }
            </div>
            <div class="mb-3">
                <label for="capacity" class="form-label">Capacity:</label>
                <InputNumber id="capacity" @bind-Value="Room.Capacity" class="form-control" />
                <ValidationMessage For="() => Room.Capacity" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="capacity" class="form-label">Price ($ / hr):</label>
                <InputNumber id="price" @bind-Value="Room.Price" class="form-control" />
                <ValidationMessage For="() => Room.Price" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
            <button type="reset" class="btn btn-secondary ms-2" @onclick="Cancel">
                Cancel
            </button>
        </EditForm>
    </div>
</div>

@code {
    private string? statusMessage = "";

    [SupplyParameterFromForm]
    public Room Room { get; set; } = new();

    private Room[]? Rooms;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        using var context = MeetingDbFactory.CreateDbContext();
        Rooms = context.Room.AsEnumerable<Room>().ToArray<Room>();
    }

    // To protect from overposting attacks, see https://aka.ms/RazorPagesCRUD
    public async Task AddRoom()
    {
        using var context = MeetingDbFactory.CreateDbContext();
        if (statusMessage!.Equals(""))
        {
            context.Room.Add(Room);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("Account/Admin/Rooms");
        }
        
    }
    public void Cancel()
    {
        NavigationManager.NavigateTo("Account/Admin/Rooms");
    }
}
