@page "/Account/Complaints/ComplaintReplies/ComplaintRepliesReplies"
@inject IDbContextFactory<PennStateSoft.Data.UserComplaints> ComplaintsDbFactory
@attribute [Authorize]

<QuickGrid ItemsProvider="@ReplyReplyGridProvider" Theme="chat">
    <TemplateColumn Context="ComplaintReplyReply" Align="Align.Right">
        <CascadingValue Value="ComplaintReply" IsFixed="true">
            <CascadingValue Value="@ComplaintReplyReply" IsFixed="true">
                <ComplaintReplyReplyDetails OnSaveCallback="UpdateGridProvider" />
            </CascadingValue>
        </CascadingValue>
    </TemplateColumn>
</QuickGrid>

@code {

    PaginationState paginationState = new PaginationState { ItemsPerPage = 10 };
    GridItemsProvider<ComplaintReplyReply>? ReplyReplyGridProvider;

    [CascadingParameter]
    private ComplaintReply? ComplaintReply { get; set; } = default!;

    protected override void OnInitialized()
    {
        if (ComplaintReply is not null && ComplaintReply.Replies is not null)
        {
            var rows = ComplaintReply.Replies;
            UpdateGridProvider(rows);

        }
    }
    private void UpdateGridProvider(SaveChangesEventArgs eventArgs)
    {
        UpdateGridProvider(ComplaintReply.Replies);
    }
    private void UpdateGridProvider(List<ComplaintReplyReply> replies)
    {
        var result = GridItemsProviderResult.From<ComplaintReplyReply>(items: replies!, totalItemCount: replies!.Count);
        ReplyReplyGridProvider = req => ValueTask.FromResult(result);
    }
}