@page "/auth"

@attribute [Authorize]

<PageTitle>Auth</PageTitle>

<AuthorizeView>
    @context.User.Identity?.Name
</AuthorizeView>

@code{
    AuthorizeAttribute? authorize { get; set; }

    public void Testing()
    {
        authorize.Roles += "Admin";
        authorize.AuthenticationSchemes += "Role";
    }
}
