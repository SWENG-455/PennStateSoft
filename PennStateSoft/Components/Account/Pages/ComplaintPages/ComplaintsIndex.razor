@page "/Account/Complaints"

@inject IDbContextFactory<PennStateSoft.Data.UserComplaints> ComplaintsDbFactory
@inject IDbContextFactory<PennStateSoft.Data.ApplicationDbContext> AppDbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@attribute [Authorize]

<PageTitle>Complaints</PageTitle>

<div style="align-content:baseline; width:85%">
    <div>
        <div class="header-container me-5">
            <h3>Complaints</h3>
            <AuthorizeView Roles="Client">
                <div class="showHover nav-item px-3">
                    <button class="btn btn-labeled btn-newComplaint" type="button"
                            @onclick="OnMouseClicked" @onmouseenter="ShowButtonInfo" @onmouseleave="HideButtonInfo">
                        <i class="icon1"></i>
                    </button>
                    <div class="showHover text-nowrap" data-hover="@ButtonInfo" style="position:relative;">
                    </div>
                </div>
            </AuthorizeView>
        </div>

        @if (complaints is not null && complaints.Count() > 0)
        {
            <div class="grid" tabindex="-1">
                <QuickGrid ItemsProvider="@complaintProvider" Class="table">
                    <TemplateColumn Context="complaint">
                        <div class="mt-3">
                            @{
                                using var userContext = AppDbFactory.CreateDbContext();
                                var complaintAuthor = userContext.Users.FirstOrDefault(u => u.UserName == complaint.Username);
                            }
                            @if (complaintAuthor is not null)
                            {
                                imageSource = string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(complaintAuthor.ProfilePic!));
                            }
                            <img src=@imageSource style="width:30px; height:30px; margin-right: 5px; object-fit:cover; border-radius:30px;" />
                            <a class="ms-1 text-nowrap" href="@($"Account/Complaints/Details?id={complaint.Id}")">@(complaint.Subject)</a>
                        </div>
                        <div class="mt-2 mb-3 ms-5">
                            @Encoding.ASCII.GetString(complaint.Description!)
                        </div>
                    </TemplateColumn>

                    <PropertyColumn Property="@(complaint => complaint.Closed)" Class="visually-hidden" />

                    <TemplateColumn Context="complaint">
                        <div class="mt-3" style="text-align:right; width:90%">
                            <div style="color:#0070E0">
                                Posted on
                            </div>
                            <div class="mt-2 text-nowrap text-black-50">
                                @complaint.Created.ToLongDateString().Substring(@complaint.Created.ToLongDateString().IndexOf(',') + 2) @complaint.Created.ToShortTimeString()
                            </div>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        }
        else
        {
            <hr />
            <p class="ms-1 mt-2" style="color:lightslategray; text-align:center;">No new complaints.</p>
        }
    </div>
</div>

@code {
    PaginationState paginationState = new PaginationState { ItemsPerPage = 10 };
    GridItemsProvider<Complaint>? complaintProvider;

    private ApplicationUser user = default!;

    [Parameter]
    public string NewComplaint { get; set; } = "New Complaint";

    [Parameter]
    public string ButtonInfo { get; set; } = "";

    [Parameter]
    public string? imageSource { get; set; }

    private bool IsToolTipShowing = false;
    private List<Complaint>? complaints;

    private ClaimsPrincipal? claimsPrincipal { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        claimsPrincipal = authState.User;
        var userName = claimsPrincipal?.Identity?.Name;
        using var userContext = await AppDbFactory.CreateDbContextAsync();
        user = await userContext.Users.FirstOrDefaultAsync(u => u.UserName == userName);

        using var context = ComplaintsDbFactory.CreateDbContext();
        var response = context.Complaint.Where(complaint => complaint.Username == user.UserName);
        complaints = response.ToList();

        if (await UserManager.IsInRoleAsync(user, "Admin"))
        {
            response = context.Complaint;
            complaints = response.ToList();
        }

        var rows = response.AsEnumerable<Complaint>().OrderByDescending(c => c.Created).ToList<Complaint>();
        var result = GridItemsProviderResult.From<Complaint>(items: rows, totalItemCount: rows.Count);
        complaintProvider = req => ValueTask.FromResult(result);
    }

    private void OnMouseClicked()
    {
        NavigationManager.NavigateTo("/Account/Complaints/Create");
    }
    private void ShowButtonInfo()
    {
        ButtonInfo = "File a complaint";
    }
    private void HideButtonInfo()
    {
        Task.Delay(3500);
        ButtonInfo = "";
    }
}