@page "/Account/Meetings/Delete"

@inject PennStateSoft.Data.MeetingContext MeetingDb
@inject NavigationManager NavigationManager

@attribute [Authorize]

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Meeting</h4>
    <hr />
    @if (meeting is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@meeting.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-10">@meeting.Date</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Time</dt>
            <dd class="col-sm-10">@meeting.Time</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Duration</dt>
            <dd class="col-sm-10">@meeting.Duration</dd>
        </dl>
        <EditForm method="post" Model="meeting" OnValidSubmit="DeleteThisMeeting" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(meeting is null)">Delete</button> |
            <a href="/meetings">Back to List</a>
        </EditForm>
    }
</div>

@code {
    Meeting? meeting;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        meeting = await MeetingDb.Meeting.FirstOrDefaultAsync(m => m.Id == Id);

        if (meeting is null)
        {
            try
            {
                NavigationManager.NavigateTo("/Account/NotFound");
            }
            catch (NavigationException navEx)
            {
                navEx.HelpLink = "/Account/Help";
            }
        }
    }

    public async Task DeleteThisMeeting()
    {
        MeetingDb.Meeting.Remove(meeting!);
        await MeetingDb.SaveChangesAsync();
        NavigationManager.NavigateTo("Account/Meetings");
    }
}
