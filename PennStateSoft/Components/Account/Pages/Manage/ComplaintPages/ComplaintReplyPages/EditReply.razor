@inject PennStateSoft.Data.ComplaintReplies ReplyDb
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h4>ComplaintReply</h4>
<hr />
@if (ComplaintReply is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="ComplaintReply" OnValidSubmit="UpdateComplaintReply" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary />
                <input type="hidden" name="ComplaintReply.Id" value="@ComplaintReply.Id" />
                <div class="mb-3">
                    <label for="username" class="form-label">Username:</label>
                    <InputText id="username" @bind-Value="ComplaintReply.Username" class="form-control" />
                    <ValidationMessage For="() => ComplaintReply.Username" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="subject" class="form-label">Subject:</label>
                    <InputText id="subject" @bind-Value="ComplaintReply.Subject" class="form-control" />
                    <ValidationMessage For="() => ComplaintReply.Subject" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="created" class="form-label">Created:</label>
                    <InputDate id="created" @bind-Value="ComplaintReply.Created" class="form-control" />
                    <ValidationMessage For="() => ComplaintReply.Created" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="closed" class="form-label">Closed:</label>
                    <InputDate id="closed" @bind-Value="ComplaintReply.Closed" class="form-control" />
                    <ValidationMessage For="() => ComplaintReply.Closed" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <InputText id="description" @bind-Value="Description" class="form-control" />
                    <ValidationMessage For="() => Description" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/complaintreplies">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    private string Description { get; set; } = "";

    [SupplyParameterFromForm]
    public ComplaintReply? ComplaintReply { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ComplaintReply ??= await ReplyDb.ComplaintReply.FirstOrDefaultAsync(m => m.Id == Id);

        if (ComplaintReply is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more details, see https://aka.ms/RazorPagesCRUD.
    public async Task UpdateComplaintReply()
    {
        ReplyDb.Attach(ComplaintReply!).State = EntityState.Modified;

        ComplaintReply!.Description = Encoding.ASCII.GetBytes(Description);

        try
        {
            await ReplyDb.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ComplaintReplyExists(ComplaintReply!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.Refresh();
    }

    bool ComplaintReplyExists(int id)
    {
        return ReplyDb.ComplaintReply.Any(e => e.Id == id);
    }
}
