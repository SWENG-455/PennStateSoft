
@inject IDbContextFactory<PennStateSoft.Data.NotificationContext> DbFactory
@inject IDbContextFactory<PennStateSoft.Data.MeetingContext> MeetingDbFactory
@inject IDbContextFactory<PennStateSoft.Data.ApplicationDbContext> AppDbFactory
@inject IDbContextFactory<PennStateSoft.Data.UserComplaints> ComplaintsDbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@attribute [Authorize]
<div>
@if (NotificationsProvider is null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (IsComplaintAuthor || IsAdmin)
    {
        @if (ExistingUnreadNotifications)
        {
            <p3>
                <QuickGrid Class="table" ItemsProvider="@NotificationsProvider">
                    <TemplateColumn Context="notification">
                        <CascadingValue Value="notification">
                            <CascadingValue Value="notifications">
                                <CascadingValue Value="User" IsFixed="true">
                                    <HomePageNotificationDetails OnDeleteCallback="UpdateGridProvider" />
                                </CascadingValue>
                            </CascadingValue>
                        </CascadingValue>
                    </TemplateColumn>
                </QuickGrid>
            </p3>
        }
        else
        {
            <p class="ms-1">No new notifications.</p>
        }
    }
    else
    {
        <p class="ms-1">No new notifications.</p>
    }
}
</div>

@code {
    GridItemsProvider<Notification>? NotificationsProvider;
    private List<Notification>? notifications;

    private string? UserName;
    private bool IsAdmin = false;
    private bool IsComplaintAuthor = false;
    private bool ExistingUnreadNotifications = true;
    private ComplaintReply? complaintReply;

    [CascadingParameter]
    public ApplicationUser? User { get; set; } = default!;

    List<IdentityRole>? Roles;
    List<IdentityRole>? ComplaintAuthorRoles;
    List<IdentityRole>? ComplaintReplyAuthorRoles;
    List<IdentityRole>? MeetingCreatorRoles;
    List<IdentityRole>? InviteeRoles;
    IdentityRole? ComplaintAuthor, ComplaintReplyAuthor;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        var Notifications = context.Notification.ToList<Notification>();
        notifications = Notifications;

        if (User is not null)
        {
            UserName = User.UserName;
            using var appContext = await AppDbFactory.CreateDbContextAsync();

            //Get the users roles
            var userRoles = appContext.UserRoles.Where(ur => ur.UserId == User.Id);
            Roles = new List<IdentityRole>();

            if (userRoles is not null)
            {
                foreach (var userRole in userRoles)
                {
                    var role = await appContext.Roles.FirstOrDefaultAsync(r => r.Id == userRole.RoleId);
                    Roles.Add(role!);
                }
            }
            if (Roles.FirstOrDefault(r => r.Name == "Admin") is not null)
            {
                IsAdmin = true;
            }

            //Check if the user has created any complaints or meetings, or has been invited to any meetings
            ComplaintAuthorRoles = Roles.Where(r => r.Name!.Contains("ComplaintAuthor")).ToList();
            MeetingCreatorRoles = Roles.Where(r => r.Name!.Contains("MeetingCreator")).ToList();
            InviteeRoles = Roles.Where(r => r.Name!.Contains("Invitee")).ToList();
        }

        if (notifications is not null)
        {
            foreach (var notification in notifications)
            {
                //Get all of the complaint reply author roles corresponding to the specific notification
                using var appContext = await AppDbFactory.CreateDbContextAsync();
                ComplaintReplyAuthorRoles = appContext.Roles.Where(r => r.Name!.
                    Contains("ComplaintReplyAuthor" + notification.ReferenceID + "_")).ToList();
                await SetUserState(notification);
            }
            notifications = notifications.Where(n => n.IsAuthor == false && n.Author != User.UserName && (n.IsReferenceOwner == true || IsAdmin)
                                                && n.Read == false).ToList();
            notifications = notifications.OrderByDescending(n => n.Created).ToList();
            notifications = notifications.Take(2).ToList();

            if (notifications is null || notifications.Count <= 0)
            {
                ExistingUnreadNotifications = false;
            }
            var Result = GridItemsProviderResult.From<Notification>(items: notifications, totalItemCount: notifications.Count);
            NotificationsProvider = request => ValueTask.FromResult(Result);
        }
    }

    private async Task SetUserState(Notification notification)
    {  
        if (notification is not null)
        {
            if (ComplaintAuthorRoles is not null && ComplaintAuthorRoles.Count() > 0)
            {
                ComplaintAuthor = ComplaintAuthorRoles.FirstOrDefault(r => r.Name == "ComplaintAuthor" + notification.ReferenceID);

                if (ComplaintAuthor is not null)
                {
                    IsComplaintAuthor = true;
                    notification.IsReferenceOwner = true;
                    await UpdateNotification(notification);
                }
                else
                {
                    notification.IsReferenceOwner = false;
                    await UpdateNotification(notification);
                }
            }
            if (ComplaintReplyAuthorRoles is not null && ComplaintReplyAuthorRoles.Count() > 0)
            {
                //Get only the complaint reply author roles corresponding to the currently logged in user
                var userComplaintReplyAuthorRoles = Roles.Where(r => r.Name!.Contains("ComplaintReplyAuthor" + notification.ReferenceID + "_"));

                if (userComplaintReplyAuthorRoles.Count() > 0)
                {
                    foreach (var role in userComplaintReplyAuthorRoles)
                    {
                        if (role is not null)
                        {
                            if (notification.Author == User!.UserName)
                            {
                                notification.IsAuthor = true;
                                await UpdateNotification(notification);
                            }
                            else
                            {
                                notification.IsAuthor = false;
                                await UpdateNotification(notification);
                            }
                        }
                    }
                }
                else
                {
                    notification.IsAuthor = false;
                    await UpdateNotification(notification);
                }
            }
            else
            {
                if (IsComplaintAuthor)
                {
                    notification.IsAuthor = true;
                    await UpdateNotification(notification);
                }
                else
                {
                    notification.IsAuthor = false;
                    await UpdateNotification(notification);
                }
            }
        }
    }

    public async Task UpdateNotification(Notification notification)
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(notification!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!NotificationExists(notification!.Id))
            {
                NavigationManager.NavigateTo("NotFound");
            }
            else
            {
                throw;
            }
        }
    }

    bool NotificationExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Notification.Any(e => e.Id == id);
    }

    private void UpdateGridProvider()
    {
        UpdateGridProvider(notifications!);
    }
    private void UpdateGridProvider(List<Notification> notifications)
    {
        var result = GridItemsProviderResult.From<Notification>(items: notifications!, totalItemCount: notifications!.Count);
        NotificationsProvider = req => ValueTask.FromResult(result);
    }
}

