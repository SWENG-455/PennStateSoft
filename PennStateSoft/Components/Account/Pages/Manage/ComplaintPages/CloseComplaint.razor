@page "/Account/Manage/Complaints/Delete"

@using PennStateSoft
@using Microsoft.EntityFrameworkCore
@using System.Text
@using System.Text.Encodings.Web

@inject PennStateSoft.Data.UserComplaints DB
@inject PennStateSoft.Data.ComplaintReplies RepliesDB
@inject NavigationManager NavigationManager

<PageTitle>Close Complaint</PageTitle>


<div>
    @if (complaint is null)
    {
        <hr />
        <p><em>Loading...</em></p>
    }
    else {
        <h3 class="alert-danger">@complaint.Subject: Mark as resolved?</h3>
        <hr />
        <div class="forms-control border border-light border-start-0 border-end-0 border-bottom-0
               border-top-0" cols="80">
            <div class="m-3">
                <label for="username" class="form-label" style="color:#0070E0"> Username: </label>
                <label class=" form-label m-2 text-black-50"> @complaint.Username </label>
                <label for="created" class="form-label" style="text-align:right; width:55%; color:#0070E0"> Posted On: </label>
                <label class=" form-label text-black-50" style="text-align:right;"> @complaint.Created </label>
            </div>
            <div class="m-3">
                <textarea class="text-black ms-lg-3 text-wrap border-light border-start-0 border-end-0" cols="100"
                          rows="@uIHelper.Rows" disabled>
                    @Encoding.ASCII.GetString(complaint.Description!)
                    </textarea>
            </div>
        </div>
        <EditForm method="post" Model="complaint" OnValidSubmit="DeleteComplaint" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(complaint is null)">Resolve</button> |
            <a href="/account/manage/complaints" class="text-decoration-none">Back to List</a>
        </EditForm>
    }
</div>

@code {
    Complaint? complaint;

    ComplaintReply[]? complaintReplies;


    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected UIHelper uIHelper = new();

    protected override async Task OnInitializedAsync()
    {
        complaint = await DB.Complaint.FirstOrDefaultAsync(m => m.Id == Id);

        if (complaint is null)
        {
            NavigationManager.NavigateTo("notfound");
        }

        var response = RepliesDB.ComplaintReply.Where(m => m.ComplaintId == complaint!.Id);
        complaintReplies = response.AsEnumerable<ComplaintReply>().ToArray();

        uIHelper.CalculateSize(@Encoding.ASCII.GetString(complaint!.Description!));
    }

    public async Task DeleteComplaint()
    {
        if (complaintReplies is not null)
        {
            foreach (ComplaintReply reply in complaintReplies!)
            {
                RepliesDB.Remove(reply);
            }
            await RepliesDB.SaveChangesAsync();
        }
        
        DB.Complaint.Remove(complaint!);
        await DB.SaveChangesAsync();
        NavigationManager.NavigateTo("/account/manage/complaints");
    }
}
