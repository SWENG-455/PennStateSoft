@page "/Account/Complaints/Details"

@inject IDbContextFactory<PennStateSoft.Data.UserComplaints> ComplaintsDbFactory
@inject IDbContextFactory<PennStateSoft.Data.ApplicationDbContext> AppDbFactory
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IdentityRedirectManager IdentityRedirectManager
@rendermode InteractiveServer

@attribute [Authorize]

<PageTitle>Complaint Details</PageTitle>

<div>
    @if (complaint is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        @if (userName == complaint.Username || IsAdmin)
        {
            <div style="align-content:baseline; background-color:whitesmoke; width:85%">
                <div class="ms-5 mt-5">
                    <h3>@complaint!.Subject</h3>
                    <hr />
                    <div class="border border-light border-start-0 border-end-0 border-bottom-0
                                border-top-0">
                        <div class="m-1">
                            <img src=@imageSource style="width:30px; height:30px; margin-right: 5px; object-fit:cover; border-radius:30px;" />
                            <label class=" form-label m-2 me-5" style="color:#0070E0"> @complaint.Username</label>
                            <label class="form-label text-black-50" style="text-align:right; width:40%;"> 
                                @complaint.Created.ToLongDateString() at @complaint.Created.ToShortTimeString() 
                             </label>
                        </div>
                        <div class="m-1 ms-5">
                            <textarea class="text-black text-wrap" style="border:none; background-color:whitesmoke" cols="100"
                                      rows="@UIhelper.Rows" disabled>
                                @Encoding.ASCII.GetString(complaint.Description!)
                                </textarea>
                        </div>
                    </div>
                    <div class="ms-5">
                        <AuthorizeView Roles="Client">
                            <a href="@($"/Account/Complaints/Edit?id={complaint.Id}")" class="me-2 mb-2 mt-2 ms-1 text-decoration-none">Edit</a> |
                            <a class=" m-2 text-decoration-none" href="@($"Account/Complaints/Delete?id={complaint.Id}")">Close</a> |
                            <a href="@($"/Account/Complaints")" class="text-decoration-none">Back</a>
                            <hr />
                        </AuthorizeView>
                    </div>

                    <div class="ms-4">
                        <AuthorizeView Roles="Admin">
                            <button id="back" type="button" class="btn btn-primary text-primary ms-3" style="border:none; background:inherit;"
                                    @onclick="OnBackClicked">
                                Back
                            </button> |
                            <CascadingValue Value="complaint">
                                <CreateComplaintReply OnSaveNewReplyCallback="@OnReplied" />
                            </CascadingValue>
                        </AuthorizeView>
                    </div>
                    @if (complaint.ComplaintReplies is not null && complaint.ComplaintReplies.Count() > 0)
                    {
                        @if (SeeReplies)
                        {
                            @if (complaint.ComplaintReplies.Count() == 1)
                            {
                                SeeHideReplies = "Hide " + complaint.ComplaintReplies.Count() + " reply";
                            }
                            else
                            {
                                SeeHideReplies = "Hide " + complaint.ComplaintReplies.Count() + " replies";
                            }
                        }
                        else
                        {
                            @if (complaint.ComplaintReplies.Count() == 1)
                            {
                                SeeHideReplies = "See " + complaint.ComplaintReplies.Count() + " reply";
                            }
                            else
                            {
                                SeeHideReplies = "See " + complaint.ComplaintReplies.Count() + " replies";
                            }
                        }
                        <div class="ms-4">
                            <button class="btn-link ms-4 mb-3 text-decoration-none" @onclick=OnClickSeeReplies style="border:none;
                                        background-color:whitesmoke;">
                                @SeeHideReplies
                            </button>
                        </div>
                    }
                    @if (SeeReplies)
                    {
                        <div class="ms-3">
                            <CascadingValue Value="complaint">
                                <ComplaintReplyIndex />
                                <a id="replies"></a>
                            </CascadingValue>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <NotFound/>
        }
    }
</div>

@code {
    private Complaint? complaint;
    private bool SeeReplies = false;
    private string? SeeHideReplies;
    private static int ReplyCount = 0;
    private static int ReplyReplyCount = 0;
    private static int ReplyReplyReplyCount = 0;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    public string? Description { get; set; }
    private UIHelper UIhelper = new();
    private string? userName;
    private ApplicationUser? User;
    private bool IsAdmin = false;
    private Notification? notification;

    [Parameter]
    public string? imageSource { get; set; }

    private IBrowserFile? file { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = ComplaintsDbFactory.CreateDbContext();
        complaint = await context.Complaint.FirstOrDefaultAsync(m => m.Id == Id);

        if (complaint is null)
        {
            NavigationManager.NavigateTo("/Account/NotFound");
        }
        else
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            userName = user.Identity?.Name;
            User = await UserManager.GetUserAsync(user);
            using var userContext = await AppDbFactory.CreateDbContextAsync();
            var complaintAuthor = await userContext.Users.FirstOrDefaultAsync(u => u.UserName == complaint.Username);

            if (complaintAuthor?.ProfilePic is not null)
            {
                imageSource = string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(complaintAuthor.ProfilePic));
            }
            IsAdmin = await UserManager.IsInRoleAsync(User!, "Admin");
            using var replyContext = ComplaintsDbFactory.CreateDbContext();
            complaint.ComplaintReplies = replyContext.ComplaintReply.Where(c => c.ComplaintId == Id).ToList<ComplaintReply>();
            Description = Encoding.ASCII.GetString(complaint.Description!);
            UIhelper.CalculateSize(Description);
        }
    }   
    
    private void OnReplied(SaveChangesEventArgs saveChangesEventArgs)
    {
        NavigationManager.Refresh(true);
    }
    private void OnClickSeeReplies()
    {
        SeeReplies = !SeeReplies;
    }

    private void OnBackClicked()
    {
        NavigationManager.NavigateTo("/Account/Complaints");
    }
}