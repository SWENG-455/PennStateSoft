@page "/"

<PageTitle>Home</PageTitle>

<div3 class="page">
    <main>
        <article class="content px-4">
            <div class="card">
                <h1 class="text-color-animation" style="font-size:2.1vw;">Meeting Scheduling System (MSS)</h1>
            </div>
        </article>
    </main>
</div3>

<AuthorizeView>
    <body>  
        <div class="container">
            <div class ="card1">
                <UserGreeting></UserGreeting>
                <div class="wrapper">
                    <div class="grid-container1">
                        <div class="grid-item1 firstItem">
                            <div class="card2">
                                <h2>
                                    Meetings:
                                    <b><a href="default.asp" target="_blank">View all › </a></b>
                                </h2>
                                <div class="grid-container">
                                    <div class="grid-item item1">
                                        <div class="mainList">
                                            <h3>Upcoming Meetings</h3>
                                            <article class="meeting">
                                                <img src="/test3.svg" alt="Meeting Icon" class="meetingImage">
                                                <span class="meetingName">Meeting 1</span>
                                                <span class="meetingInfo">Date. Time. <span>Room.</span></span>
                                            </article>
                                            <article class="meeting">
                                                <img src="/test3.svg" alt="Meeting Icon" class="meetingImage">
                                                <span class="meetingName">Meeting 2</span>
                                                <span class="meetingInfo">Date. Time. <span>Room.</span></span>
                                            </article>
                                            <article class="meeting">
                                                <img src="/test3.svg" alt="Meeting Icon" class="meetingImage">
                                                <span class="meetingName">Meeting 3</span>
                                                <span class="meetingInfo">Date. Time. <span>Room.</span></span>
                                            </article>
                                        </div>
                                    </div>
                                    <div class="grid-item item2">
                                        <button class="btn-labeled btn-newMeeting">
                                            <div class="btn-label"><i class="icon1"></i></div>Schedule a Meeting
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class ="grid-item1 secondItem">
                            <div class="grid-container">
                                <div class="card2">
                                    <div class="header">
                                        <div class="month">July</div>
                                        <div class="year">2024</div>
                                    </div>
                                    <div class="calendar">
                                        <div class="day header">Sun</div>
                                        <div class="day header">Mon</div>
                                        <div class="day header">Tue</div>
                                        <div class="day header">Wed</div>
                                        <div class="day header">Thu</div>
                                        <div class="day header">Fri</div>
                                        <div class="day header">Sat</div>
                                        <div class="day">1</div>
                                        <div class="day">2</div>
                                        <div class="day">3</div>
                                        <div class="day">4</div>
                                        <div class="day">5</div>
                                        <div class="day">6</div>
                                        <div class="day">7</div>
                                        <div class="day">8</div>
                                        <div class="day">9</div>
                                        <div class="day">10</div>
                                        <div class="day">11</div>
                                        <div class="day">12</div>
                                        <div class="day">13</div>
                                        <div class="day">14</div>
                                        <div class="day">15</div>
                                        <div class="day">16</div>
                                        <div class="day">17</div>
                                        <div class="day">18</div>
                                        <div class="day">19</div>
                                        <div class="day">20</div>
                                        <div class="day">21</div>
                                        <div class="day">22</div>
                                        <div class="day">23</div>
                                        <div class="day">24</div>
                                        <div class="day">25</div>
                                        <div class="day">26</div>
                                        <div class="day">27</div>
                                        <div class="day">28</div>
                                        <div class="day">29</div>
                                        <div class="day today">30</div>
                                        <div class="day">31</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="grid-item1 thirdItem">
                            <div class="grid-container2">
                                <div class="grid-item3 itemCard1">
                                    <div class="card2">
                                        <p3>
                                            Notifications:
                                        </p3>
                                        <div class="grid-container">
                                            <div class="grid-item2 itemButton1">
                                                <b><a href="default.asp" target="_blank">View all › </a></b>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="grid-item3 itemCard2">
                                    <div class="card2">
                                        <p3>
                                            Complaints:
                                        </p3>
                                        <div class="grid-container">
                                            <div class="grid-item2 itemButton1">
                                                <button class="button4">
                                                    <p1>File a Complaint</p1>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>
</AuthorizeView>
