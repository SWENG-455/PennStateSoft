@page "/Account/Complaints/Delete"

@inject IDbContextFactory<PennStateSoft.Data.UserComplaints> ComplaintsDbFactory
@inject IDbContextFactory<PennStateSoft.Data.NotificationContext> NotificationsDbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IRoleStore<IdentityRole> RoleStore
@inject IRoleValidator<IdentityRole> RoleValidator
@inject IEnumerable<RoleValidator<IdentityRole>> RoleValidators
@inject ILogger<RoleManager<IdentityRole>> RoleLogger
@inject IdentityErrorDescriber IdentityErrorDescriber
@inject ILookupNormalizer KeyNormalizer

@attribute [Authorize(Roles = "Client")]

<PageTitle>Close Complaint</PageTitle>

@if (UserName == complaint?.Username)
{
    <div>
        @if (complaint is null)
        {
            <hr />
            <p><em>Loading...</em></p>
        }
        else
        {
            <h3 class="link-danger">Mark as resolved?</h3>
            <hr class="link-danger" />
            <h4 class="mt-4">@complaint.Subject</h4>
            <hr />
            <div class="forms-control border border-light border-start-0 border-end-0 border-bottom-0
               border-top-0" cols="80">
                <div>
                    <label for="username" class="form-label" style="color:#0070E0"> Username: </label>
                    <label class=" form-label m-2 me-5 text-black-50"> @complaint.Username </label>
                    <label class="ms-5 form-label text-black-50"> @complaint.Created.ToLongDateString() at @complaint.Created.ToShortTimeString() </label>
                </div>
                <div class="mt-3 mb-4">
                    <textarea class="text-black text-wrap" style="border:none; background-color:Window" cols="100"
                              rows="4" disabled>
                        @Encoding.ASCII.GetString(complaint.Description!)
                        </textarea>
                </div>
            </div>
            <EditForm method="post" Model="complaint" OnValidSubmit="DeleteComplaint" FormName="close-complaint" Enhance>
                <button type="submit" class="btn btn-danger ms-3" disabled="@(complaint is null)">Resolve</button>
                <a class="btn btn-secondary ms-2" href="Account/Complaints">
                    Cancel
                </a>
            </EditForm>
        }
    </div>
}
else
{
    <NotFound/>
}


@code {
    Complaint? complaint;

    private string? UserName;
    private ApplicationUser user = default!;
    private ClaimsPrincipal? claimsPrincipal;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected UIHelper uIHelper = new();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private ApplicationRoleManager? RoleManager;
    private IdentityRole? Role;
    private Notification? notification;
    protected override async Task OnInitializedAsync()
    {
        using var context = ComplaintsDbFactory.CreateDbContext();
        complaint = await context.Complaint.FirstOrDefaultAsync(m => m.Id == Id);

        if (complaint is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            var authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
            claimsPrincipal = authenticationState.User;

            if (claimsPrincipal is not null)
            {
                user = await UserManager.GetUserAsync(claimsPrincipal);

            }
            if (user is not null)
            {
                UserName = user.UserName;
            }
        }

        uIHelper.CalculateSize(@Encoding.ASCII.GetString(complaint!.Description!));
    }
    private async Task RemoveRoles()
    {
        RoleManager = new ApplicationRoleManager(RoleStore, RoleValidators, KeyNormalizer, IdentityErrorDescriber, RoleLogger);
        Role = await RoleManager.FindByNameAsync("ComplaintAuthor" + complaint!.Id).ConfigureAwait(false);
        //var Users = UserManager.GetUsersInRoleAsync("MeetingCreator" + meeting.Id).Result;

        var result = await RoleManager.DeleteAsync(Role!);

        using var context = ComplaintsDbFactory.CreateDbContext();
        var complaintReplies = context.ComplaintReply.Where(cr => cr.ComplaintId == complaint.Id).ToList();

        if (complaintReplies is not null)
        {
            foreach (var complaintReply in complaintReplies)
            {
                Role = await RoleManager.FindByNameAsync("ComplaintReplyAuthor" + complaint!.Id + "_" + complaintReply.Id).ConfigureAwait(false);
                result = await RoleManager.DeleteAsync(Role!);
            }
        }
    }
    private async Task CreateNotification()
    {
        notification = new Notification
            {
                ReferenceID = complaint.Id,
                Author = user!.UserName,
                Message = "closed the complaint, ",
                Link = $"/Account/Complaints/Details?id={complaint.Id}",
                LinkTo = $"{complaint.Subject}",
                IsAuthor = true
            };

        await AddNotification();
    }
    private async Task AddNotification()
    {
        //Add notifications to alert admins of the closure of this complaint
        using var context = NotificationsDbFactory.CreateDbContext();
        context.Notification.Add(notification!);
        await context.SaveChangesAsync();
    }
    private async Task DeleteNotifications()
    {
        //Delete the notifications created by Admin replies to this complaint
        using var context = NotificationsDbFactory.CreateDbContext();
        var notifications = context.Notification.Where(n => n.ReferenceID == complaint.Id && n.Author != user.UserName);
        if (notifications is not null && notifications.Count() > 0)
        {
            foreach (var notification in notifications)
            {
                context.Notification.Remove(notification);
                await context.SaveChangesAsync();
            }
        }
    }
    private async Task DeleteComplaint()
    {
        using var context = ComplaintsDbFactory.CreateDbContext();
        context.Complaint.Remove(complaint!);
        await CreateNotification();
        await RemoveRoles();
        await  DeleteNotifications();
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/Account/Complaints");
    }
}
