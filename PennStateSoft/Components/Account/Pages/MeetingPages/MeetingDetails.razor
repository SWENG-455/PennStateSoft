@page "/Account/Meetings/Details"

@inject IDbContextFactory<PennStateSoft.Data.MeetingContext> MeetingDbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@attribute [Authorize]

<PageTitle>Meeting Details</PageTitle>

<div>
    <h4>Meeting Details</h4>
    <hr />
    @if (meeting is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@meeting.Name</dd>
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-10">@meeting.Date</dd>
            <dt class="col-sm-2">Time</dt>
            <dd class="col-sm-10">@meeting.Time</dd>
            <dt class="col-sm-2">Duration</dt>
            <dd class="col-sm-10">@meeting.Duration hr(s) </dd>
            <dt class="col-sm-2">Room</dt>
            <dd class="col-sm-10">@room!.Name</dd>
        </dl>
        <CascadingValue Value="Id">
            <CascadingValue Value="meeting">
                <UpdateMeetingComponent />
            </CascadingValue>
        </CascadingValue>
       
        <div>
            <AuthorizeView Roles="Creator, Admin">
                <a class="text-decoration-none" href="@($"Account/Meetings/Edit?id={meeting.Id}")">Edit</a> |
             </AuthorizeView>
            <a class="text-decoration-none" href="@($"Account/Meetings")">Back</a>
        </div>
    }
</div>

@code {
    Meeting? meeting;

    [SupplyParameterFromForm]
    private string? selectedUser { get; set; }

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    private Room? room { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = MeetingDbFactory.CreateDbContext();
        meeting = await context.Meeting.FirstOrDefaultAsync(m => m.Id == Id);

        if (meeting is not null)
        {
            using var roomContext = MeetingDbFactory.CreateDbContext();
            room = await roomContext.Room.FirstOrDefaultAsync(r => r.Id == meeting.RoomId);
        }
        else
        {
            try
            {
                NavigationManager.NavigateTo("/Account/NotFound");
            }
            catch (NavigationException navEx)
            {
                var source = navEx.Source;
            }
        }
    }
}
