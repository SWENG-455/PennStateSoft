@page "/Account/Manage/Complaints"

@using Microsoft.AspNetCore.Components.QuickGrid
@inject PennStateSoft.Data.UserComplaints DB
@inject UserManager<ApplicationUser> UserManager
@inject IdentityUserAccessor UserAccessor

@using PennStateSoft
@using System.Text
@using System.Text.Encodings.Web
@using PennStateSoft.Migrations
@using Microsoft.AspNetCore.Identity
@using PennStateSoft.Data


<PageTitle>Complaints</PageTitle>

<h3>Complaints</h3>

<div class="nav-item px-3">
    <NavLink style="text-decoration:none" href="Account/Manage/Complaints/Create">
        <span class="bi-plus-square-fill-nav-menu" aria-hidden="true"></span> New
    </NavLink>
</div>


<div class="grid" tabindex="-1">
    <QuickGrid ItemsProvider="@complaintProvider" Class="table">
        <TemplateColumn Context="complaint">
            <a class="text-nowrap" href="@($"account/manage/complaints/details?id={complaint.Id}")">@(complaint.Subject)</a>
        </TemplateColumn>
        <PropertyColumn Property="@(complaint => complaint.Closed)" Class="visually-hidden" />
        <PropertyColumn Property="@(complaint => @Encoding.ASCII.GetString(complaint.Description!))" />
        <PropertyColumn Property="@(complaint => complaint.Created)" />
    </QuickGrid>
</div>


@code {
    GridItemsProvider<Complaint>? complaintProvider;

    private ApplicationUser user = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        var response = DB.Complaint.Where(complaint => complaint.Username == user.UserName);
        var rows = response.AsEnumerable<Complaint>().ToList<Complaint>();
        var result = GridItemsProviderResult.From<Complaint>(items: rows, totalItemCount:rows.Count);
        complaintProvider = req => ValueTask.FromResult(result);
    }
}