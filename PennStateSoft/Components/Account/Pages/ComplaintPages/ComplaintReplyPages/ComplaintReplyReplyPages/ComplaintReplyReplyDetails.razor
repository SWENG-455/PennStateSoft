@inject IDbContextFactory<PennStateSoft.Data.UserComplaints> ComplaintsDbFactory
@inject IDbContextFactory<PennStateSoft.Data.ApplicationDbContext> AppDbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IRoleStore<IdentityRole> RoleStore
@inject IRoleValidator<IdentityRole> RoleValidator
@inject IEnumerable<RoleValidator<IdentityRole>> RoleValidators
@inject ILogger<RoleManager<IdentityRole>> RoleLogger
@inject IdentityErrorDescriber IdentityErrorDescriber
@inject ILookupNormalizer KeyNormalizer

@attribute [Authorize]

<PageTitle>ComplaintReply Reply Details</PageTitle>

<div>
    @if (ComplaintReplyReply is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div id ="replyreply" class="m-3">
            <div class="m-3">
                <label for="username" class="form-label" style="color:#0070E0"> Username: </label>
                @if (IsAdmin)
                {
                    <label class=" form-label m-2 me-5 text-black-50"> @ComplaintReplyReply.Username (Admin) </label>
                }
                else
                {
                    <label class=" form-label m-2 me-5 text-black-50"> @ComplaintReplyReply.Username </label>
                }
                <label class="ms-5 form-label text-black-50">
                    @ComplaintReplyReply.Created.ToLongDateString() at
                    @ComplaintReplyReply.Created.ToShortTimeString()
                </label>
                @if (!EditClicked)
                {
                    <div class="m-1">
                        <textarea class="text-black text-wrap" cols="100"
                                  style="border:none; background-color:Window;" disabled>
                            @Encoding.ASCII.GetString(ComplaintReplyReply!.Description!)
                        </textarea>
                    </div>
                }
                @if (!UserName!.Equals(ComplaintReplyReply.Username) && !EditClicked)
                {
                    <div>
                        <CascadingValue Value="ComplaintReplyReply" IsFixed="true">
                            <CreateComplaintReplyReply OnSaveNewReplyCallback="OnSaveClicked" />
                        </CascadingValue>
                    </div>
                }
                @if (UserName!.Equals(ComplaintReplyReply.Username) && !EditClicked)
                {
                    <div>
                        <button id="edit" type="button" class="btn btn-primary text-primary" style="border:none; background:inherit;"
                                @onclick="OnEditClicked">
                            Edit
                        </button> |

                        <button id="delete" type="submit" class="btn btn-danger text-danger" disabled="@(ComplaintReplyReply is null)"
                                style="border:none; background:inherit;" @onclick="DeleteReplyReply">
                            Delete
                        </button>
                    </div>
                    <hr/>
                }
                @if (EditClicked)
                {
                    <EditForm method="post" Model="ComplaintReplyReply" OnValidSubmit="UpdateReplyReply" FormName="edit-complaintreplyreply" Enhance>
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="m-1">
                            <textarea id="description" @bind="Description" @bind:event="oninput" class="text-black text-wrap" cols="100"
                                      style="border:none; background-color:Window;" autofocus>
                                @Encoding.ASCII.GetString(ComplaintReplyReply!.Description!)
                                                </textarea>
                        </div>
                        <div class="m-1">
                            <button type="submit" class="btn btn-primary">Save </button>
                            <button type="button" class="btn btn-secondary" @onclick="OnEditClicked">Cancel</button>
                        </div>
                    </EditForm>
                    <hr/>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<SaveChangesEventArgs> OnSaveCallback { get; set; }

    [CascadingParameter]
    Complaint? complaint { get; set; } = default!;

    [CascadingParameter]
    ComplaintReply? complaintReply { get; set; } = default!;

    [SupplyParameterFromQuery]
    public int replyId { get; set; }

    [SupplyParameterFromForm]
    private string? Description { get; set; }

    [CascadingParameter]
    public ReplyReply? ComplaintReplyReply { get; set; } = default!;

    private UIHelper UIhelper = new();

    [CascadingParameter]
    public bool EditClicked { get; set; } = default!;

    private ApplicationUser? User;
    private bool IsAdmin = false;

    private ClaimsPrincipal? claimsPrincipal { get; set; }

    private string? UserName { get; set; }

    private ApplicationRoleManager? RoleManager;
    private IdentityRole? Role;

    protected override async Task OnInitializedAsync()
    {
        if (ComplaintReplyReply is null)
        {
            try
            {
                NavigationManager.NavigateTo("/Account/NotFound");
            }
            catch (NavigationException ex)
            {
                var source = ex.Source;
            }
        }
        else
        {
            //Get the logged in user
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            claimsPrincipal = authState.User;
            UserName = claimsPrincipal.Identity.Name;

            //Check if the reply creator is an admin
            using var context = await AppDbFactory.CreateDbContextAsync();
            User = await context.Users.FirstOrDefaultAsync(u => u.UserName == ComplaintReplyReply.Username);
            var adminRole = await context.Roles.FirstOrDefaultAsync(r => r.Name == "Admin");
            var userRole = await context.UserRoles.FirstOrDefaultAsync(ur => ur.RoleId == adminRole.Id && ur.UserId == User.Id);

            if (userRole is not null)
            {
                IsAdmin = true;
            }
        }
    }
    private void OnEditClicked()
    {
        EditClicked = !EditClicked;
    }
    private async Task OnSaveClicked()
    {
        await OnSaveCallback.InvokeAsync();
    }
    public async Task UpdateReplyReply()
    {
        using var context = ComplaintsDbFactory.CreateDbContext();
        context.Attach(ComplaintReplyReply!).State = EntityState.Modified;

        if (Description is not null)
        {
            ComplaintReplyReply!.Description = Encoding.ASCII.GetBytes(Description);
        }

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ReplyReplyExists(ComplaintReplyReply!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }
        OnEditClicked();
        await OnSaveCallback.InvokeAsync();
    }
    private async Task RemoveRole(ReplyReply complaintreplyReply)
    {
        RoleManager = new ApplicationRoleManager(RoleStore, RoleValidators, KeyNormalizer, IdentityErrorDescriber, RoleLogger);

        if (complaint is not null && complaintreplyReply is not null)
        {
            Role = await RoleManager.FindByNameAsync("ReplyReplyAuthor" + complaintReply!.Id + "_" + complaintreplyReply.Id).ConfigureAwait(false);
            var result = await RoleManager.DeleteAsync(Role!);
        }
    }

    public async Task DeleteReplyReply()
    {
        await RemoveRole(ComplaintReplyReply!);
        using var context = ComplaintsDbFactory.CreateDbContext();
        context.ReplyReply.Remove(ComplaintReplyReply!);
        context.Attach(complaintReply!).State = EntityState.Modified;
        await context.SaveChangesAsync();
        OnEditClicked();
        await OnSaveCallback.InvokeAsync();
    }

    bool ReplyReplyExists(int id)
    {
        using var context = ComplaintsDbFactory.CreateDbContext();
        return context.ReplyReply.Any(e => e.Id == id);
    }
}
