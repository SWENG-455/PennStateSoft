@page "/Account/Rooms/Delete"

@inject IDbContextFactory<PennStateSoft.Data.MeetingContext> MeetingDbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@attribute [Authorize(Roles = "Admin")]
<PageTitle>Delete</PageTitle>

<h3 class="link-danger">Are you sure you want to delete this room?</h3>
<hr class="link-danger" />
<div>
    @if (room is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @if (room.MeetingId > -1)
        {
            <p class="alert-danger" style="width:fit-content">
                @message
            </p>
        }
        <h3 class="mt-4">@room.Name</h3>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@room.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Capacity</dt>
            <dd class="col-sm-10">@room.Capacity</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Price</dt>
            <dd class="col-sm-10">$@room.Price / hr</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Occupied</dt>
            <dd class="col-sm-10">
                @if (room.MeetingId > 0)
                {
                    <p>True</p>
                }
                else
                {
                    <p>False</p>
                }
            </dd>
        </dl>
        <EditForm method="post" Model="room" OnValidSubmit="Delete_Room" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(room is null)">Delete</button>
            <button type="reset" class="btn btn-secondary ms-2" @onclick="Cancel">
                Cancel
            </button>
        </EditForm>
    }
</div>
@code {
    Room? room;
    private string? message;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = MeetingDbFactory.CreateDbContext();
        room = await context.Room.FirstOrDefaultAsync(m => m.Id == Id);

        if (room is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
    public void Cancel()
    {
        NavigationManager.NavigateTo("Account/Rooms");
    }

    public async Task Delete_Room()
    {
        using var context = MeetingDbFactory.CreateDbContext();
        if (room!.MeetingId == 0)
        {
            context.Room.Remove(room!);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("Account/Rooms");
        }
        else
        {
            message = "Cannot do that now. " + room.Name + " is currently occupied";
        }
    }
}
