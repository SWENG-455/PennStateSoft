@inject PennStateSoft.Data.UserComplaints ComplaintsDb

@attribute [Authorize]

<PageTitle>Index</PageTitle>

<QuickGrid ItemsProvider="@ComplaintReplyGridProvider" Class="table" Theme="chat">
    <TemplateColumn Context="complaintreply" Align="Align.Right">
        <CascadingValue Value="Complaint">
            <CascadingValue Value="@complaintreply">
                <ReplyDetails />
            </CascadingValue>
        </CascadingValue>
    </TemplateColumn>
</QuickGrid>

@code{

    PaginationState paginationState = new PaginationState { ItemsPerPage = 10 };
    GridItemsProvider<ComplaintReply>? ComplaintReplyGridProvider;

    [CascadingParameter]
    private Complaint? Complaint { get; set; } = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;


    protected override void OnInitialized()
    {
        if (Complaint is not null)
        {
            var rows = Complaint.ComplaintReplies;
            var result = GridItemsProviderResult.From<ComplaintReply>(items: rows!, totalItemCount: rows!.Count);
            ComplaintReplyGridProvider = req => ValueTask.FromResult(result);
        }
     }
    
}